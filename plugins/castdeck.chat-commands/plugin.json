{
  "$schema": "https://cast.flue.live/plugins/schema/plugin-v1.json",
  "id": "castdeck.chat-commands",
  "name": "Comandos de chat",
  "description": "Responde comandos do chat (!discord, !sorteio, !redes) com mensagem, aviso na tela ou mídia.",
  "version": "1.0.0",
  "author": { "name": "flue.live — Miguel Kallemback", "url": "https://cast.flue.live" },
  "license": "AGPL-3.0-only",
  "homepage": "https://cast.flue.live/plugins",
  "engines": { "castdeck": ">=1.8.25", "api": 1 },
  "tier": "declarative",
  "permissions": ["events:chat", "chat:send", "overlay:show"],
  "i18n": ["pt-BR", "en", "es"],
  "settings": [
    { "key": "prefixo", "label": "Prefixo dos comandos", "type": "text", "default": "!" },
    { "key": "cooldownSeg", "label": "Intervalo por pessoa (segundos)", "type": "number", "default": 30 }
  ],
  "rules": [
    {
      "on": "chat.comando",
      "comando": "discord",
      "cooldownSeg": 30,
      "do": [
        { "type": "chat.send", "texto": "Entre no nosso Discord: {{texto}}" },
        { "type": "overlay.show", "titulo": "Discord", "texto": "discord.gg/exemplo", "cor": "#5865f2", "segundos": 8 }
      ]
    },
    {
      "on": "chat.comando",
      "comando": "redes",
      "cooldownSeg": 60,
      "do": [{ "type": "chat.send", "texto": "Estamos no YouTube, Twitch e Kick — valeu pelo apoio!" }]
    },
    {
      "on": "chat.comando",
      "comando": "aviso",
      "cooldownSeg": 20,
      "do": [{ "type": "overlay.show", "titulo": "Aviso", "texto": "Pergunta da live: {{arg1}}", "cor": "#ffcc00", "segundos": 6 }]
    },
    {
      "on": "chat.regex",
      "padrao": "^!(oi|ola|olá)\\b",
      "flags": "i",
      "cooldownSeg": 45,
      "do": [{ "type": "chat.send", "texto": "Oi, {{usuario}}! Bem-vindo(a) à live." }]
    }
  ]
}
